# Base URL of the CMS backend API. Do not include a trailing slash.
# All fetches in this app run server-side, so under Docker Compose this
# should be the internal backend service URL instead (see root .env.example
# / PUBLIC_FRONTEND_API_URL, default http://backend:5000/api/v1).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

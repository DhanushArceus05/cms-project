# Root environment file consumed by docker-compose.yml.
#
# Usage:
#   cp .env.example .env
#   (edit .env with real values)
#
# Do not commit the real .env file — it is git-ignored.

# --- MongoDB ---------------------------------------------------------------
# Database name only; the host/port are fixed to the `mongodb` Compose
# service internally and are not configurable here.
MONGO_DB_NAME=cms-assignment

# --- Backend (cms-backend) --------------------------------------------------
# Must be at least 16 characters. Generate a real random value for anything
# beyond local/demo use, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string_at_least_16_chars
JWT_EXPIRES_IN=1d

# Used only by `docker compose exec backend npm run seed` to create the one
# admin account.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!

# Comma-separated list of browser origins allowed to call the API. Must
# match the host URLs the admin and public frontends are actually served on.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Frontend build-time API URLs ------------------------------------------
# NEXT_PUBLIC_* values are baked into each Next.js app at `docker compose
# build` time, so they are configured here as build arguments rather than
# plain runtime environment variables.
#
# Admin frontend (cms-admin-frontend): all API calls happen in the browser
# (Bearer token kept in localStorage), so this must be an address the user's
# browser — running on the host — can reach.
ADMIN_FRONTEND_API_URL=http://localhost:5000/api/v1

# Public frontend (cms-public-frontend): every fetch happens server-side
# inside the container (page render + generateMetadata), so this should be
# the Docker-internal backend address, not localhost or a host port.
PUBLIC_FRONTEND_API_URL=http://backend:5000/api/v1
